# Copy this file to .env on the server and fill in real values.
# .env is ignored by git, so the secret key never reaches GitHub.
# Locally you don't need a .env file at all: the defaults are for development.

# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Must be False on the live server.
DJANGO_DEBUG=False

# Comma-separated domain names the site is served from.
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com

# Comma-separated addresses of the deployed front-end (leave empty until it's deployed).
DJANGO_CORS_ORIGINS=

# Only needed once the project sends email (e.g. Gmail: smtp.gmail.com + an app password).
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=

# Printed on the guidance letter and the certificate.
# TADREEB_INSTITUTION_NAME=جامعة الأزهر
# Where the certificate QR code points; {code} is replaced. Empty = the back-end page /verify/<code>/.
# TADREEB_CERTIFICATE_VERIFY_URL=https://tadreeb.netlify.app/verify/{code}
